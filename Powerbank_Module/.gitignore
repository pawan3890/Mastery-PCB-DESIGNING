*-rescue.kicad_sch
*-rescue.lib
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
*.000
*.net
*.bck
*.dsn
*.ses

# KiCad 9 "distribute" scratch folder
.dist/

